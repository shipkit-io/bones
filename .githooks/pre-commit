#!/usr/bin/env sh
# Secret scanner — LAC-2555
#
# Blocks commits that introduce plaintext credentials.
# Requires `gitleaks` locally; if not installed we print a warning and
# fall through — CI still runs the same scan on the PR, so this is
# defense-in-depth, not the only gate.
#
# Install:
#   macOS   → brew install gitleaks
#   linux   → https://github.com/gitleaks/gitleaks/releases

# Chain to the hooks path this repo displaced ---------------------------------
# `core.hooksPath` holds one value, so the repo-local one set by postinstall
# REPLACES a global one instead of stacking with it, and a developer's global
# pre-commit hook is silently dropped in this repo. Nothing installed globally
# can recover it: once a repo sets its own `core.hooksPath`, git never looks at
# the outer one again, so the repo is the only place this can be fixed.
#
# git >= 2.54 also honours `hook.<name>.command` config, which DOES still fire
# when core.hooksPath is displaced (measured on 2.54.0 Apple Git-157: the
# identity guard's named hook runs before this file). Chaining anyway means a
# hook registered BOTH ways runs twice. That is the deliberate direction: a
# pre-commit hook is veto-shaped, so a second run is idempotent, whereas
# suppressing the chain would silently drop a hook git never ran at all.
# See LAC-7263.
displaced_hooks_path() {
  # Which value would core.hooksPath have had without this repo's override?
  # `--global --get` is the wrong question in two ways: it ignores the system
  # scope, and it does NOT follow an `[include]` from the global file.
  # Measured on git 2.54.0, with core.hooksPath set in ~/.gitconfig.local and
  # included from ~/.gitconfig: an unscoped read returns the value and reports
  # its scope as `global`, while `git config --global --get core.hooksPath`
  # exits 1 and prints nothing. The first version of this function used that
  # read, which made it dead code on the one machine it was written for.
  #
  # So ask every scope in precedence order, drop the ones that belong to this
  # checkout, and keep the last survivor.
  raw=$(git config --show-scope --get-all core.hooksPath 2>/dev/null) || raw=""
  [ -n "$raw" ] || return 0
  printf '%s\n' "$raw" | awk -F'\t' '
    $1 != "local" && $1 != "worktree" && $1 != "command" { outer = $2 }
    END { if (outer != "") print outer }
  '
}
chain_displaced_pre_commit() {
  outer=$(displaced_hooks_path)
  if [ -z "$outer" ]; then
    # `--show-scope` landed in git 2.26. On older git this loses an included
    # or system-scoped value, which is still better than losing the chain.
    outer=$(git config --global --get core.hooksPath 2>/dev/null) || outer=""
  fi
  [ -n "$outer" ] || return 0
  case "$outer" in
    "~/"*) outer="$HOME/${outer#"~/"}" ;;
  esac
  [ -x "$outer/pre-commit" ] || return 0
  # Never re-enter this file: a displaced path pointing at this directory
  # would recurse until the shell runs out of processes.
  here=$(cd -- "$(dirname -- "$0")" 2>/dev/null && pwd -P) || return 0
  there=$(cd -- "$outer" 2>/dev/null && pwd -P) || return 0
  [ "$here" != "$there" ] || return 0
  "$outer/pre-commit" "$@"
}
chain_displaced_pre_commit "$@" || exit $?

if command -v gitleaks >/dev/null 2>&1; then
  # `gitleaks protect` is deprecated upstream and will be removed; `gitleaks git`
  # replaces it (v8.19.0+). Probe for the subcommand once, so that losing it can
  # never be reported as a secret. See LAC-7261.
  if gitleaks git --help >/dev/null 2>&1; then
    gitleaks_scan=git
  else
    gitleaks_scan=protect
  fi

  # `--exit-code 2` moves a finding off exit 1, leaving 1 to mean "the scan did
  # not run" (unknown subcommand, unreadable .gitleaks.toml). It is a root
  # persistent flag present since v8.0.0, so every gitleaks old enough to lack
  # the `git` subcommand still honours it. Measured on 8.30.1: finding 2,
  # clean 0, nothing staged 0, unknown subcommand 1, broken config 1.
  gitleaks_status=0
  gitleaks "$gitleaks_scan" --staged --redact --no-banner --exit-code 2 || gitleaks_status=$?

  case "$gitleaks_status" in
    0) ;;
    2)
      echo ""
      echo "gitleaks found a potential secret in staged changes."
      echo "If real: rotate the credential first, then remove it from the diff."
      echo "If a false positive: extend .gitleaks.toml allowlist or add an inline"
      echo "'gitleaks:allow' comment. Do not disable the hook."
      exit 1
      ;;
    *)
      echo "" >&2
      echo "gitleaks exited ${gitleaks_status}: the secret scan did NOT run." >&2
      echo "This is a tool or config failure, not a finding in your diff." >&2
      echo "Fix the tool (brew upgrade gitleaks) or .gitleaks.toml, then retry." >&2
      echo "Do not reach for --no-verify: nothing has scanned this commit." >&2
      exit 1
      ;;
  esac
else
  echo "gitleaks not installed — skipping local secret scan (CI still runs)."
  echo "  install: brew install gitleaks"
fi
